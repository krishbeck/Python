# Your instance URL, e.g. https://dev12345.service-now.com
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com

# Option 1: basic auth (a dedicated integration user is recommended)
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# Option 2: OAuth bearer token (takes precedence over basic auth when set)
SERVICENOW_TOKEN=

# Optional: request timeout in seconds (default 30)
SERVICENOW_TIMEOUT=30
